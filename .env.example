# =============================================================================
# Loadshare RCA Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your keys.

# -----------------------------------------------------------------------------
# REQUIRED — NVIDIA NIM
# -----------------------------------------------------------------------------
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# Optional overrides; defaults are fine
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=meta/llama-3.3-70b-instruct
# LLM_TIMEOUT_S=60

# -----------------------------------------------------------------------------
# OPTIONAL — Redis (semantic cache)
# -----------------------------------------------------------------------------
# If reachable, agent caches RCA reports by embedding similarity.
# Cache hit skips resolver+classifier+RCA nodes. Without Redis: NoOpCache.
#
# Local install (Windows):
#   https://github.com/tporadowski/redis/releases
# Docker:
#   docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_THRESHOLD=0.92
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# -----------------------------------------------------------------------------
# OPTIONAL — LangSmith (tracing)
# -----------------------------------------------------------------------------
# Get a key from https://smith.langchain.com/
# Uncomment all four to activate:
#
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_your-key-here
# LANGCHAIN_PROJECT=loadshare-rca
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# Server / auth
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEMO_USERS=demo:demo,manit:manit
