# ============================================================================
# .gitignore — Loadshare RCA Agent
# ============================================================================

# --- Secrets & local config -------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# Keep the example template
!.env.example

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenvs
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/

# Type checking
.mypy_cache/
.pyright/
.dmypy.json

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# Notebooks
.ipynb_checkpoints/
*.ipynb

# --- Node / MCP server ------------------------------------------------------
mcp-servers/node_modules/
mcp-servers/npm-debug.log*
mcp-servers/yarn-debug.log*
mcp-servers/yarn-error.log*
mcp-servers/package-lock.json

# --- Data: built artifacts but keep source CSVs -----------------------------
data/loadshare.db
data/loadshare.db-journal
data/loadshare.db-wal
data/loadshare.db-shm
data/transactions.db
data/transactions.db-journal
data/transactions.db-wal
data/transactions.db-shm

# --- Logs & runtime ---------------------------------------------------------
logs/
*.log
locust_results/
.streamlit/secrets.toml

# --- IDE / OS junk ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Tool caches ------------------------------------------------------------
.cache/
.ruff_cache/
.hypothesis/

# --- Docker -----------------------------------------------------------------
# (Keep Dockerfiles and compose files; ignore build state only)
.docker-build-cache/
